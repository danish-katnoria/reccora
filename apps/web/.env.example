# Base URL of the Reccora API incl. version prefix (server-side only; the browser talks to this app's /api/proxy).
API_URL=http://localhost:3000/api/v1
# Origin of the API as reachable from the shopper's browser. Merchant click-through (/go/:id) redirects there.
API_PUBLIC_URL=http://localhost:3000
# Public origin of this web app (used for share links and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3002
