# ---- Core ----
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins (admin dashboard). Empty = no CORS.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Public base URL used to build shareable storefront links (e.g. https://reccora.com). Links look like <url>/c/<handle>.
PUBLIC_WEB_URL=http://localhost:3002
LOG_LEVEL=info

# ---- Database ----
# PostgreSQL connection string (matches docker-compose.yml).
DATABASE_URL=postgresql://reccora:reccora@localhost:5432/reccora?schema=public

# ---- Auth ----
# Generate each with: openssl rand -hex 48   (min 32 chars, must differ)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# true = users must verify email before login (requires SMTP_URL in real environments)
REQUIRE_EMAIL_VERIFICATION=false
# true = new creators are approved automatically; false = admin approval required
CREATOR_AUTO_APPROVE=true

# ---- Object storage ----
# STORAGE_DRIVER=s3 (default) uses the S3-compatible settings below (MinIO via docker-compose).
# STORAGE_DRIVER=local stores uploads on disk in LOCAL_UPLOAD_DIR and serves them at <API_PUBLIC_URL>/uploads (dev only; no Docker needed).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
# Origin the API is reachable at FROM CLIENTS. Android emulators use http://10.0.2.2:3000; physical devices use your LAN IP.
API_PUBLIC_URL=http://localhost:3000
# ---- S3-compatible settings ----
# Leave S3_ENDPOINT empty for AWS S3; set it for MinIO/R2/etc.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reccora-media
S3_ACCESS_KEY_ID=reccora
S3_SECRET_ACCESS_KEY=reccora-dev-secret
S3_FORCE_PATH_STYLE=true
# Public base URL that serves the bucket (CDN or bucket URL). Uploaded media URLs are built from this.
S3_PUBLIC_BASE_URL=http://localhost:9000/reccora-media

# ---- Email ----
MAIL_FROM="Reccora <no-reply@example.com>"
# e.g. smtps://user:pass@smtp.example.com:465 . If empty, emails are logged to the console (dev only).
SMTP_URL=

# ---- Affiliate tracking ----
# Shared secret for the generic signed webhook (POST /api/v1/affiliate/generic/callback).
# Leave empty to keep conversion tracking disabled ("pending integration").
AFFILIATE_WEBHOOK_SECRET=
# Salt for hashing client IPs on click records. Set a random value in production.
IP_HASH_SALT=change-me

# ---- Seed (dev only) ----
SEED_PASSWORD=Password123!
