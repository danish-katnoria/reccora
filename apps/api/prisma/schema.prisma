generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHOPPER
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum CreatorStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  REMOVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum LinkStatus {
  PENDING
  APPROVED
  DISABLED
}

enum ConversionStatus {
  PENDING
  CONFIRMED
  REVERSED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAYABLE
  PAID
  VOID
}

enum PayoutStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum CommissionRuleScope {
  DEFAULT
  CATEGORY
  BRAND
  CREATOR
}

enum NotificationType {
  NEW_FOLLOWER
  POST_PUBLISHED
  CREATOR_APPROVED
  CREATOR_SUSPENDED
  POST_REMOVED
  COMMISSION_UPDATE
  SYSTEM
}

enum ReportTargetType {
  POST
  CREATOR
  PRODUCT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  passwordHash     String
  displayName      String
  role             Role       @default(SHOPPER)
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  avatarUrl        String?
  isProfilePrivate Boolean    @default(false)
  showActivity     Boolean    @default(true)
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  creatorProfile   CreatorProfile?
  refreshTokens    RefreshToken[]
  tokens           VerificationToken[]
  follows          Follow[]
  savedProducts    SavedProduct[]
  savedCollections SavedCollection[]
  productViews     ProductView[]
  notifications    Notification[]
  reports          Report[]            @relation("ReportReporter")
  reviewedReports  Report[]            @relation("ReportReviewer")

  @@index([role, status])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  id        String       @id @default(uuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model CreatorProfile {
  id            String        @id @default(uuid())
  userId        String        @unique
  handle        String        @unique
  bio           String?
  avatarUrl     String?
  coverUrl      String?
  status        CreatorStatus @default(PENDING)
  followerCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts              Post[]
  collections        Collection[]
  followers          Follow[]
  storefrontProducts StorefrontProduct[]
  clicks             ProductClick[]
  visits             StorefrontVisit[]
  conversions        AffiliateConversion[]
  commissions        CommissionRecord[]
  payouts            Payout[]
  commissionRules    CommissionRule[]

  @@index([status, followerCount])
}

model Brand {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  websiteUrl String?
  logoUrl    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products        Product[]
  commissionRules CommissionRule[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryTree")
  products        Product[]
  commissionRules CommissionRule[]

  @@index([parentId])
}

model Product {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  description  String?
  price        Decimal       @db.Decimal(12, 2)
  currency     String        @default("USD") @db.VarChar(3)
  status       ProductStatus @default(ACTIVE)
  brandId      String?
  categoryId   String?
  merchantName String
  attributes   Json?
  saveCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  links              ProductLink[]
  postProducts       PostProduct[]
  collectionProducts CollectionProduct[]
  storefrontProducts StorefrontProduct[]
  saved              SavedProduct[]
  views              ProductView[]
  clicks             ProductClick[]

  @@index([status, categoryId, price])
  @@index([status, createdAt])
  @@index([brandId])
  @@index([title])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// A purchasable merchant/affiliate destination for a product. Only APPROVED links are ever redirected to.
model ProductLink {
  id                String     @id @default(uuid())
  productId         String
  merchantName      String
  url               String
  affiliateProvider String?
  status            LinkStatus @default(PENDING)
  isPrimary         Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  clicks  ProductClick[]

  @@index([productId, status])
}

model Post {
  id           String     @id @default(uuid())
  creatorId    String
  caption      String
  mediaUrl     String
  mediaType    MediaType  @default(IMAGE)
  thumbnailUrl String?
  status       PostStatus @default(PUBLISHED)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  products PostProduct[]

  @@index([creatorId, status, publishedAt])
  @@index([status, publishedAt])
}

model PostProduct {
  postId    String
  productId String
  position  Int    @default(0)

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
}

// Products a creator has added to their storefront.
model StorefrontProduct {
  creatorId String
  productId String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([creatorId, productId])
  @@index([productId])
}

model Collection {
  id          String   @id @default(uuid())
  creatorId   String
  title       String
  slug        String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(true)
  saveCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator  CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  products CollectionProduct[]
  savedBy  SavedCollection[]

  @@unique([creatorId, slug])
  @@index([isPublic, saveCount])
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}

model Follow {
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())

  follower User           @relation(fields: [followerId], references: [id], onDelete: Cascade)
  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([followerId, creatorId])
  @@index([creatorId])
}

model SavedProduct {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@index([userId, createdAt])
}

model SavedCollection {
  userId       String
  collectionId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([userId, collectionId])
  @@index([collectionId])
}

model ProductView {
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt])
}

model StorefrontVisit {
  id        String   @id @default(uuid())
  creatorId String
  userId    String?
  createdAt DateTime @default(now())

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, createdAt])
}

// An outbound click. A click is NOT a sale. attributionRef is the opaque reference passed to the merchant/affiliate network (e.g. as sub-id).
model ProductClick {
  id             String   @id @default(uuid())
  attributionRef String   @unique
  productId      String
  linkId         String
  creatorId      String?
  postId         String?
  userId         String?
  source         String?
  userAgent      String?
  ipHash         String?
  createdAt      DateTime @default(now())

  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  link        ProductLink           @relation(fields: [linkId], references: [id], onDelete: Cascade)
  creator     CreatorProfile?       @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  conversions AffiliateConversion[]

  @@index([productId, createdAt])
  @@index([creatorId, createdAt])
}

// Evidence-backed conversion reported by a trusted provider callback or verified import. Never created from clicks.
model AffiliateConversion {
  id                String           @id @default(uuid())
  provider          String
  externalId        String
  attributionRef    String?
  clickId           String?
  creatorId         String?
  status            ConversionStatus @default(PENDING)
  orderAmount       Decimal          @db.Decimal(12, 2)
  currency          String           @default("USD") @db.VarChar(3)
  merchantReference String?
  rawPayload        Json?
  occurredAt        DateTime
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  click      ProductClick?     @relation(fields: [clickId], references: [id], onDelete: SetNull)
  creator    CreatorProfile?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  commission CommissionRecord?

  @@unique([provider, externalId])
  @@index([creatorId, status])
  @@index([attributionRef])
}

model CommissionRule {
  id         String              @id @default(uuid())
  name       String
  scope      CommissionRuleScope @default(DEFAULT)
  rate       Decimal             @db.Decimal(5, 4) // creator share of order amount, 0..1
  categoryId String?
  brandId    String?
  creatorId  String?
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  category Category?       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand    Brand?          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator  CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
}

model CommissionRecord {
  id           String           @id @default(uuid())
  conversionId String           @unique
  creatorId    String
  amount       Decimal          @db.Decimal(12, 2)
  currency     String           @default("USD") @db.VarChar(3)
  rate         Decimal          @db.Decimal(5, 4)
  ruleId       String?
  status       CommissionStatus @default(PENDING)
  payoutId     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  conversion AffiliateConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  creator    CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  payout     Payout?             @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([creatorId, status])
  @@index([payoutId])
}

// Admin-reviewed payout record. No money moves automatically.
model Payout {
  id           String       @id @default(uuid())
  creatorId    String
  amount       Decimal      @db.Decimal(12, 2)
  currency     String       @default("USD") @db.VarChar(3)
  status       PayoutStatus @default(DRAFT)
  reference    String?
  note         String?
  reviewedById String?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  creator     CreatorProfile     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  commissions CommissionRecord[]

  @@index([creatorId, status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  targetType   ReportTargetType
  targetId     String
  reason       String
  details      String?
  status       ReportStatus     @default(OPEN)
  reviewedById String?
  resolution   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  reporter User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
}
